FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     rhoSimpleFoam;

startFrom       latestTime;

startTime       0;

stopAt          endTime;

endTime         501;

deltaT          1;

writeControl    timeStep;

writeInterval   500;

purgeWrite      1;

writeFormat     ascii;

writePrecision   8;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable true;

functions
{
    #includeFunc MachNo
    #includeFunc solverInfo

    forces1
    {
       type          forces;

       libs          ("libforces.so");

       executeControl  writeTime;

       log           yes;

       patches       ("wing");
       origin (0.25 0 0);
       rotation
        {
            type            axes;
            e3              (0 0 1);
            e1              (1 0 0);
        }

    }

}

